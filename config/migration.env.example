# Copy this file outside version control, restrict it to the operator, and pass
# it with: bin/migrate.sh --config /secure/path/migration.env preflight

# mysql reads the password from this option file. It must contain a [client]
# section and should be chmod 0600.
MYSQL_DEFAULTS_FILE=/secure/path/migration-client.cnf
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_SOCKET=
MYSQL_USER=migration_operator

SOURCE_AUTH_SCHEMA=auth
SOURCE_CHARACTERS_SCHEMA=characters
SOURCE_WORLD_SCHEMA=world
TARGET_AUTH_SCHEMA=acore_auth_migrated
TARGET_CHARACTERS_SCHEMA=acore_characters_migrated
CONTROL_SCHEMA=acore_migration_control
REALM_ID=1

# Both source checkouts are required. Relative paths are resolved from the
# wow-db-migration repository root, not from the current working directory.
# These defaults support three sibling directories under one parent directory.
# Absolute paths are also supported. The runner verifies the pinned commits.
TRINITYCORE_DIR=../TrinityCore
AZEROTHCORE_DIR=../azerothcore-wotlk
EXPECTED_TRINITYCORE_COMMIT=a1fca43764
EXPECTED_AZEROTHCORE_COMMIT=5bdaa898d

CHUNK_SIZE=100000
REQUIRE_QUIESCENT=1
ALLOW_SOURCE_ARCHIVE=1

# Optional. Leave empty to let preflight create a UUID. Set this when resuming a run from another operator host.
MIGRATION_RUN_ID=
