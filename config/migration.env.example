# Copy this file outside version control, restrict it to the operator, and pass
# it with: bin/migrate.sh --config /secure/path/migration.env preflight

# mysql reads the password from this option file. It must contain a [client]
# section and should be chmod 0600.
MYSQL_DEFAULTS_FILE=/secure/path/migration-client.cnf
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_SOCKET=
MYSQL_USER=migration_operator

# tc-to-ac or ac-to-tc. This value is immutable for a migration run.
MIGRATION_DIRECTION=tc-to-ac
# The example schema names below are for tc-to-ac. For ac-to-tc, point SOURCE_*
# at AzerothCore and choose fresh TrinityCore TARGET_* and CONTROL_SCHEMA names.
SOURCE_AUTH_SCHEMA=auth
SOURCE_CHARACTERS_SCHEMA=characters
SOURCE_WORLD_SCHEMA=world
TARGET_AUTH_SCHEMA=acore_auth_migrated
TARGET_CHARACTERS_SCHEMA=acore_characters_migrated
CONTROL_SCHEMA=acore_migration_control
REALM_ID=1

# Both source checkouts are required. Relative paths are resolved from the
# trinitycore-azerothcore-db-migrator repository root, not from the current
# working directory.
# These defaults support three sibling directories under one parent directory.
# Absolute paths are also supported. The runner verifies their protected
# content against the selected reviewed compatibility profile.
TRINITYCORE_DIR=../TrinityCore
AZEROTHCORE_DIR=../azerothcore-wotlk
COMPATIBILITY_PROFILE=tc335-acwotlk-v1

# Inserts benefit from larger transactions; deletes should keep undo/redo
# pressure lower.
LOAD_CHUNK_SIZE=500000
CLEANUP_CHUNK_SIZE=100000
LARGE_TABLE_ROWS=250000
DEFER_SECONDARY_INDEXES=1
REQUIRE_QUIESCENT=1
ALLOW_SOURCE_ARCHIVE=1
ALLOW_GAMEPLAY_ARCHIVE=0

# Required when nonempty SOURCE_ARCHIVE mappings exist. Keep this outside the
# repository and protect it as production data.
ARCHIVE_DIR=/secure/path/migration-archives

# Optional. Leave empty to let preflight create a UUID. Set this when resuming a run from another operator host.
MIGRATION_RUN_ID=
